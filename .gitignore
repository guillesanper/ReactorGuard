# =============================================================================
# Python
# =============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
*.whl

# Virtual environments
.venv/
venv/
env/
secrets/
.env

# Type checking
.mypy_cache/
.dmypy.json
dmypy.json
.pytype/

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover

# Resultados de evaluacion (tests/results/validator_metrics_tep.json y sucesores).
#
# Se regeneran corriendo la suite y NO se versionan, por dos motivos. Llevan
# medidas de reloj (latency_ms) que cambian en cada ejecucion, de modo que
# versionarlos ensuciaria el arbol despues de cada pytest. Y el criterio que
# contienen ya lo hace cumplir el propio test: el fichero es el informe, no la
# puerta. Verify-Phase2.ps1 (T4.7) lo consume tras ejecutar la suite, no de un
# clon recien hecho.
#
# Regla explicita a proposito: hasta ahora caian bajo el comodin *.json de la
# seccion de secretos, que los ignoraba por accidente y no por decision.
tests/results/

# =============================================================================
# Terraform
# =============================================================================
# Local state — NEVER commit; always use remote backend
*.tfstate
*.tfstate.*
*.tfstate.backup

# Crash log files
crash.log
crash.*.log

# Override files (local overrides not for version control)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform lock file IS committed; plugin cache is not
.terraform/
!.terraform.lock.hcl

# Terraform plan output (may contain secrets)
*.tfplan
*.tfvars
!*.tfvars.example

# =============================================================================
# Kubernetes / Helm
# =============================================================================
# Helm chart dependencies
charts/

# Rendered manifests (generated, not source)
rendered/

# Kubeconfig — never commit
kubeconfig
*.kubeconfig
.kube/

# =============================================================================
# ML / DVC
# =============================================================================
# DVC cache (stored in GCS, not git)
.dvc/cache/
.dvc/tmp/

# MLflow artifacts
mlruns/
mlartifacts/

# Model checkpoints and large binaries
*.pt
*.pth
*.onnx
*.pkl
*.h5

# Dataset files
*.csv
*.parquet
*.feather
data/raw/
data/processed/

# =============================================================================
# Secrets & Credentials
# =============================================================================
# GCP service account keys — NEVER commit.
#
# El comodin se mantiene a proposito: una clave descargada aterriza con el
# nombre que le ponga la consola de GCP, y enumerar patrones deja fuera justo el
# que nadie previo. El coste es que ignora TODO json, incluidos los que son
# codigo fuente, asi que cada directorio que legitimamente versiona json necesita
# su excepcion explicita abajo. Una excepcion es una decision visible en el diff;
# un fichero que desaparece en silencio, no.
*.json
service-account*.json
*-key.json
credentials.json

# Excepciones: json que es fuente, no credencial.
# Los dashboards de Grafana (T4.6) se versionan y se despliegan como ConfigMap.
!observability/**/*.json

# Environment variable files
.env
.env.*
!.env.example

# =============================================================================
# IDEs & Editors
# =============================================================================
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# =============================================================================
# Miscellaneous
# =============================================================================
*.log
*.tmp
*.bak
.cache/
